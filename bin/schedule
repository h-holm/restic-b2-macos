#!/bin/bash
#
# schedule: the LaunchAgent that runs bin/backup every day at SCHEDULE_TIME (.env).
#
#   bin/schedule show      print the LaunchAgent that install would write; changes nothing
#   bin/schedule install   build launchd/restic-b2-launcher, write the LaunchAgent to
#                          ~/Library/LaunchAgents/ and load it (again, if it was loaded)
#   bin/schedule run       start a run now through launchd: the way macOS permissions
#                          apply to the schedule. Be at the Mac for the first one.
#   bin/schedule remove    unload the LaunchAgent and delete its file
#
# install, run and remove change macOS. The launcher and the LaunchAgent necessarily hold
# this Mac's paths: launchd wants absolute paths, and the launcher has the script's path
# built in (see launchd/restic-b2-launcher.c). Both stay out of git.
#
# Written for the bash 3.2 that macOS ships as /bin/bash.

set -euo pipefail
export PATH=/usr/bin:/bin:/usr/sbin:/sbin

REPO=$(cd "$(dirname "$0")/.." && pwd)
readonly REPO
# shellcheck source=lib/restic-env.sh
. "$REPO/lib/restic-env.sh"

readonly LABEL=local.restic-b2-macos.daily
readonly PLIST=$HOME/Library/LaunchAgents/$LABEL.plist
readonly TEMPLATE=$REPO/launchd/launchagent.plist.template
readonly LAUNCHER=$REPO/launchd/restic-b2-launcher
readonly LAUNCHER_SOURCE=$REPO/launchd/restic-b2-launcher.c
readonly SCRIPT=$REPO/bin/backup
readonly LAUNCHD_LOG=$HOME/Library/Logs/restic-b2-macos.launchd.log
DOMAIN=gui/$(id -u)
readonly DOMAIN

fail() { echo "schedule: $*" >&2; exit 1; }

usage() {
    echo "usage: schedule show | install | run | remove" >&2
    exit 2
}

# The paths go into a C string and into XML, through sed: refuse the characters that
# would need escaping in one of them, rather than escape them.
check_paths() {
    local p
    for p in "$REPO" "$HOME"; do
        if [[ $p == *[\"\\\|\&\<\>]* ]]; then
            fail "$p holds one of \" \\ | & < >, which this script doesn't handle: move the repo"
        fi
    done
}

render() {
    local time re='^([01][0-9]|2[0-3]):([0-5][0-9])$' hour minute
    [[ -f $ENV_FILE ]] || fail ".env is missing (copy .env.example to .env and fill it in)"
    time=$(env_value SCHEDULE_TIME)
    [[ $time =~ $re ]] || fail "SCHEDULE_TIME in .env is not HH:MM (24-hour clock)"
    hour=$(( 10#${BASH_REMATCH[1]} ))
    minute=$(( 10#${BASH_REMATCH[2]} ))
    check_paths
    sed -e "s|@LABEL@|$LABEL|g" -e "s|@LAUNCHER@|$LAUNCHER|g" -e "s|@HOUR@|$hour|g" \
        -e "s|@MINUTE@|$minute|g" -e "s|@LAUNCHD_LOG@|$LAUNCHD_LOG|g" "$TEMPLATE"
}

loaded() { launchctl print "$DOMAIN/$LABEL" >/dev/null 2>&1; }

TMP_PLIST=""
trap '[[ -z $TMP_PLIST ]] || /bin/rm -f -- "$TMP_PLIST"' EXIT

install_agent() {
    TMP_PLIST=$(mktemp)
    local tmp=$TMP_PLIST
    render >"$tmp"
    plutil -lint -s "$tmp" || fail "the rendered LaunchAgent is not a valid plist"

    check_paths
    cc -O2 -Wall -Wextra "-DSCRIPT=\"$SCRIPT\"" -o "$LAUNCHER" "$LAUNCHER_SOURCE"
    echo "built $LAUNCHER (runs $SCRIPT)"

    if loaded; then
        launchctl bootout "$DOMAIN/$LABEL"
        sleep 1
    fi
    mkdir -p "$(dirname "$PLIST")"
    cp "$tmp" "$PLIST"
    launchctl bootstrap "$DOMAIN" "$PLIST"
    echo "installed and loaded $PLIST"
    echo "Next, at the Mac: bin/schedule run, and answer macOS's question with Allow."
}

case "${1:-}" in
    show)
        render
        ;;
    install)
        install_agent
        ;;
    run)
        loaded || fail "the LaunchAgent is not loaded: bin/schedule install"
        launchctl kickstart "$DOMAIN/$LABEL"
        echo "started; follow it in ~/Library/Logs/restic-b2-macos.log"
        ;;
    remove)
        if loaded; then
            launchctl bootout "$DOMAIN/$LABEL"
            echo "unloaded $LABEL"
        fi
        if [[ -f $PLIST ]]; then
            /bin/rm -f -- "$PLIST"
            echo "deleted $PLIST"
        fi
        ;;
    *)
        usage
        ;;
esac
