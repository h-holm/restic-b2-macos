# Settings for restic-b2-macos. Copy to .env (git-ignored, mode 600) and fill in.
# All of an installation's settings are here; the scripts have none built in.
# The secrets (B2 key, repository password) are not here: they live in the login
# keychain, put there by bin/setup.

# The restic repository: s3:https://<the bucket's Endpoint from the B2 web UI>/<bucket>
RESTIC_REPOSITORY=s3:https://s3.eu-central-003.backblazeb2.com/change-me

# The folders to back up: absolute paths, separated by ":".
BACKUP_PATHS=/Volumes/External/Photos

# A run stops before backing up if the folders hold fewer files than this between them:
# a guard against an empty or half-mounted drive. Set it well below the real count.
MIN_FILES=1000

# The start of the push titles: "<BACKUP_NAME> backup OK" and "... backup FAILED".
# ASCII letters, digits, spaces and . _ - only.
BACKUP_NAME=Offsite

# When the daily run starts, HH:MM on the 24-hour clock. After a change:
# bin/schedule install.
SCHEDULE_TIME=03:00

# ntfy pushes. Anyone who knows the topic can read and post to it: keep it out of git,
# logs and screenshots.
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=change-me

# Optional: the ping address of a healthchecks.io check (period 1 day, grace 1 day). It
# emails you when runs stop happening at all. Leave empty to skip.
HC_PING_URL=
